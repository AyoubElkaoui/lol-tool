{
  "name": "lol-tool",
  "productName": "LoL Tool",
  "version": "0.1.3",
  "description": "Runes, item sets en matchup-guide automatisch in de League-client (Windows + Mac)",
  "main": "src/main.js",
  "author": "Ayoub El Kaoui",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test:data": "node scripts/test-data.mjs",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "nl.akwebsolutions.loltool",
    "productName": "LoL Tool",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "hardenedRuntime": false,
      "identity": null
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": null
  }
}